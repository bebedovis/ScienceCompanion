# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai          # openai | ollama
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=huggingface    # huggingface | openai
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=auto             # auto | cpu | cuda

# ── Vector store (Amazon OpenSearch) ─────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=paper_chunks
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
EMBEDDING_DIM=1024          # must match the embedding model output size

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── RAG tuning ────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=6
RERANK_TOP_N=20
CHUNK_SIZE=512
CHUNK_OVERLAP=64

